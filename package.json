{
  "name": "ishamela-backend",
  "version": "0.1.0",
  "private": true,
  "description": "iShamela project-owned API (SPEC-027)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.cjs",
    "test:e2e": "jest --config test/jest-e2e.json",
    "db:migrate": "drizzle-kit migrate",
    "migrate:firebase": "tsx scripts/migrate-firebase.ts",
    "bench:progress": "tsx scripts/bench-progress.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/throttler": "^6.7.1",
    "apple-signin-auth": "^2.1.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jose": "^4.15.9",
    "nestjs-pino": "^5.2.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.30.0",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
