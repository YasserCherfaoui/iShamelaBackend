    "@nestjs/testing": "^11.2.6",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "jest": "^29.7.0",
    "supertest": "^7.3.0",
    "testcontainers": "^12.2.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
